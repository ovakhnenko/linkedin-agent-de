      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "ist-nicht-sondern",
      "regex": "(?i)\\b(?:das|es|dies) ist nicht (?:einfach |nur |bloß )?[^.!?\\n]{2,50}[,.] (?:sondern|es ist|das ist)\\b",
      "name": "\"Das ist nicht X, sondern Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "rhetorische-frage",
      "regex": "(?im)^\\s*(?:das ergebnis|der clou|der haken|das beste daran|der knackpunkt|die lösung|die antwort|das problem|und dann|warum)\\?\\s*$",
      "name": "One-line rhetorical question (\"Das Ergebnis?\")",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "staged-reveal",
      "regex": "(?im)^\\s*(?:und das beste|die wahrheit|die realität|das geheimnis|mein learning|meine learnings|meine erkenntnis)\\s*:",
      "name": "Staged reveal line (\"Die Wahrheit:\")",
      "fix": "State the point. Skip the announcement."
    },
    {
      "id": "hier-was-gelernt",
      "regex": "(?i)\\b(?:hier (?:ist|sind),? was (?:ich|wir) (?:daraus )?gelernt|das (?:habe|hab) ich (?:daraus )?gelernt\\s*:)",
      "name": "\"Hier ist, was ich gelernt habe\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b[\\w-]+, [\\w-]+ und [\\w-]+\\.",
      "name": "Rule-of-three triad (\"X, Y und Z.\")",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[🚀🔥💡✨🎯👇✅]",
      "name": "Rocket / fire / bulb / sparkle / dart / point-down / check emoji",
      "fix": "One emoji max, and not one of these."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#[\\w-]+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags max. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "als-ki",
      "regex": "(?i)\\bals (?:ki|künstliche intelligenz|sprachmodell|ki-modell)\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "fazit-opener",
      "regex": "(?im)^\\s*(?:fazit|zusammenfassend|abschließend|zum schluss|unterm strich)\\b",
      "name": "Essay-closer opener (\"Fazit:\")",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?im)(?:was (?:meint|denkt|sagt) ihr(?: dazu)?|wie seht ihr das|seht ihr das (?:auch )?so|wer kennt'?s|wer kennt das|stimmt ihr zu|hab(?:e)? ich recht|bin ich (?:der|die) einzige|was meinen sie(?: dazu)?|wie sehen sie das|eure meinung|agree|thoughts)\\s*\\??\\s*$",
      "name": "Reflex engagement bait (\"Was meint ihr?\")",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "exclaim",
      "regex": "!{2,}",
      "name": "Double exclamation mark",
      "fix": "One, or none. German LinkedIn readers find it shouty."
    }
  ]
}